<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Light Cr4sher V1 - Official</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Inter:wght@300;400;600;800&display=swap');

        /* BASE STYLING (THEME: DARK BLUE DEPTH) */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; -webkit-tap-highlight-color: transparent; }
        :root {
            --bg-body: #050810;
            --bg-card: #0f172a;
            --bg-input: #020617;
            --primary: #3b82f6;
            --accent: #6366f1;
            --text-main: #f1f5f9;
            --text-dim: #gist94a3b8;
            --danger: #ef4444;
            --success: #22c55e;
        }
        body { background: var(--bg-body); color: var(--text-main); overflow-x: hidden; }

        /* SCREENS SYSTEM */
        .screen { display: none; min-height: 100vh; width: 100%; position: absolute; top: 0; left: 0; padding-bottom: 90px; }
        .screen.active { display: flex; flex-direction: column; animation: screenIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
        @keyframes screenIn { from { opacity: 0; transform: scale(0.98) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }

        /* AUTH & LANDING ELEMENTS */
        .auth-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; padding: 25px; text-align: center; background: radial-gradient(circle at top, #1e3a8a 0%, #050810 70%); }
        .logo-main { width: 130px; height: 130px; border-radius: 50%; border: 3px solid var(--primary); box-shadow: 0 0 30px rgba(59, 130, 246, 0.5); margin-bottom: 25px; }
        .auth-title { font-family: 'Orbitron', sans-serif; font-size: 28px; margin-bottom: 10px; color: white; text-shadow: 0 0 10px var(--primary); }
        .auth-subtitle { color: var(--text-dim); font-size: 14px; margin-bottom: 35px; }
        
        .btn-main { width: 100%; padding: 16px; border-radius: 14px; border: none; font-weight: 800; cursor: pointer; transition: 0.3s; font-size: 15px; margin-bottom: 12px; display: flex; align-items: center; justify-content: center; gap: 10px; }
        .btn-blue { background: linear-gradient(90deg, #3b82f6, #2563eb); color: white; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4); }
        .btn-outline { background: rgba(255,255,255,0.05); color: white; border: 1px solid rgba(255,255,255,0.1); }
        
        input, select { width: 100%; padding: 16px; border-radius: 14px; border: 1px solid #1e293b; background: var(--bg-input); color: white; margin-bottom: 15px; outline: none; transition: 0.3s; }
        input:focus { border-color: var(--primary); box-shadow: 0 0 10px rgba(59,130,246,0.2); }

        /* LOADING SCREEN */
        #screen-loading { background: #000; z-index: 1000; justify-content: flex-start; align-items: center; padding-top: 15vh; }
        .load-box { width: 85%; max-width: 340px; height: 450px; border-radius: 20px; overflow: hidden; position: relative; border: 2px solid rgba(255,255,255,0.1); box-shadow: 0 0 40px rgba(59, 130, 246, 0.15); }
        .load-vid { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; }
        .load-text { margin-top: 30px; font-family: 'Orbitron', sans-serif; font-size: 30px; font-weight: 900; letter-spacing: 5px; color: white; text-shadow: 0 0 20px #6366f1; }

        /* TOPBAR & SIDEBAR */
        .topbar { display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; position: sticky; top: 0; background: rgba(5,8,16,0.9); backdrop-filter: blur(10px); z-index: 100; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .top-left { display: flex; align-items: center; gap: 15px; }
        .top-left i { font-size: 22px; color: white; cursor: pointer; }
        .top-brand { font-weight: 800; font-size: 18px; color: white; }
        .top-user-pfp { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--primary); padding: 2px; }

        #sidebar { position: fixed; top: 0; left: -280px; width: 270px; height: 100vh; background: var(--bg-card); z-index: 500; transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1); padding: 30px 20px; box-shadow: 10px 0 30px rgba(0,0,0,0.5); border-right: 1px solid rgba(255,255,255,0.1); }
        #sidebar.open { left: 0; }
        .side-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 499; }
        .side-overlay.active { display: block; }

        /* DASHBOARD CONTENT */
        .scroll-area { padding: 0 20px; }
        .welcome-card { background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); border-radius: 22px; padding: 22px; margin-top: 15px; margin-bottom: 25px; position: relative; overflow: hidden; }
        
        .stats-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; }
        .stat-item { background: rgba(255,255,255,0.12); padding: 15px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); }
        .stat-title { display: flex; align-items: center; gap: 8px; font-size: 11px; opacity: 0.8; margin-bottom: 6px; }
        .stat-item strong { font-size: 18px; }

        .news-slider { display: flex; overflow-x: auto; gap: 15px; padding-bottom: 10px; scrollbar-width: none; }
        .news-slider::-webkit-scrollbar { display: none; }
        
        .news-card { min-width: 290px; height: 160px; border-radius: 18px; overflow: hidden; background: #1e293b; position: relative; border: 1px solid rgba(255,255,255,0.05); }
        .news-card img { width: 100%; height: 100%; object-fit: cover; opacity: 0.6; transition: 0.3s; }
        .news-overlay { position: absolute; bottom: 0; left: 0; width: 100%; padding: 15px; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, transparent 100%); }
        .news-overlay h4 { font-size: 14px; margin-bottom: 4px; color: white; }
        .news-overlay p { font-size: 10px; color: var(--text-dim); }

        .section-title { font-size: 16px; font-weight: 700; margin: 25px 0 15px; display: flex; justify-content: space-between; }
        .grid-info { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .info-card { background: var(--bg-card); padding: 16px; border-radius: 16px; border: 1px solid #1e293b; display: flex; align-items: center; gap: 12px; }
        .info-icon { width: 35px; height: 35px; background: rgba(59,130,246,0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--primary); }
        
        .long-card { background: var(--bg-card); padding: 16px; border-radius: 16px; border: 1px solid #1e293b; margin-top: 12px; display: flex; align-items: center; gap: 15px; }

        /* MANAGE SENDER */
        .empty-sender { text-align: center; padding: 50px 20px; }
        .empty-sender i { font-size: 60px; color: var(--danger); margin-bottom: 20px; }
        .pair-code-box { background: #000; padding: 25px; border-radius: 16px; font-family: 'Orbitron', sans-serif; font-size: 24px; color: var(--primary); letter-spacing: 5px; margin: 20px 0; border: 1px solid var(--primary); box-shadow: 0 0 20px rgba(59,130,246,0.2); }

        /* WHATSAPP PANEL */
        .wa-profile-card { background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); border-radius: 20px; padding: 15px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3); }
        .wa-profile-left { display: flex; align-items: center; gap: 12px; }
        .wa-pfp { width: 45px; height: 45px; border-radius: 50%; border: 2px solid white; object-fit: cover; }
        .wa-role-badge { display: inline-block; background: rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 12px; font-size: 9px; font-weight: 800; letter-spacing: 1px; margin-top: 4px; }
        .wa-exp-info { text-align: right; }
        
        .wa-banner { width: 100%; height: 180px; border-radius: 18px; overflow: hidden; position: relative; margin-bottom: 15px; border: 1px solid rgba(255,255,255,0.1); }
        .wa-banner video { width: 100%; height: 100%; object-fit: cover; opacity: 0.8; }
        .wa-banner .overlay-text { position: absolute; bottom: 15px; left: 15px; font-weight: 800; font-size: 16px; text-shadow: 2px 2px 4px black; letter-spacing: 1px; }

        .wa-btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 25px; }
        .btn-wa-action { padding: 14px; border-radius: 14px; font-weight: 800; font-size: 14px; display: flex; justify-content: center; align-items: center; gap: 10px; cursor: pointer; transition: 0.3s; border: 1px solid rgba(255,255,255,0.1); background: transparent; color: var(--text-dim); }
        .btn-wa-action.active-red { border-color: #ef4444; color: #ef4444; background: rgba(239, 68, 68, 0.05); box-shadow: 0 0 15px rgba(239, 68, 68, 0.2); }

        /* NOTIFICATION BOXES (COOLDOWN & SUCCESS) */
        .notif-box { display: none; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 12px; font-family: monospace, sans-serif; font-size: 12px; margin-top: 15px; font-weight: 600; }
        .notif-cooldown { background: #2a1f10; border: 1px solid #b45309; color: #f59e0b; }
        .notif-success { background: #062b14; border: 1px solid #166534; color: #4ade80; }

        /* NAVBAR */
        .navbar { position: fixed; bottom: 0; width: 100%; background: #0f172a; display: flex; justify-content: space-around; padding: 12px 5px; border-top: 1px solid #1e293b; z-index: 100; box-shadow: 0 -10px 25px rgba(0,0,0,0.5); }
        .nav-item { display: flex; flex-direction: column; align-items: center; color: var(--text-dim); cursor: pointer; transition: 0.3s; flex: 1; }
        .nav-item i { font-size: 22px; margin-bottom: 4px; }
        .nav-item span { font-size: 10px; font-weight: 700; opacity: 0; transform: translateY(5px); transition: 0.3s; }
        .nav-item.active { color: white; transform: translateY(-5px); }
        .nav-item.active i { color: var(--primary); }
        .nav-item.active span { opacity: 1; transform: translateY(0); }

        /* MODALS */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(5px); }
        .modal.show { display: flex; }
        .modal-card { background: var(--bg-card); width: 90%; max-width: 360px; border-radius: 24px; padding: 25px; border: 1px solid #1e293b; text-align: center; animation: modalPop 0.3s ease-out; }
        @keyframes modalPop { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    </style>
</head>
