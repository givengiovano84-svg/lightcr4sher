    <script>
        const DB_URL = "https://gist.githubusercontent.com/givengiovano84-svg/8ed8e46e24cce8c6d9ad0cacbc973222/raw/3ea9b853cf0793fddbe195baa6487994ffd9e2f0";
        const FORMSPREE_URL = "https://formspree.io/f/xnjgqejz";

        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            const nav = document.getElementById('main-nav');
            const authScreens = ['screen-landing', 'screen-login', 'screen-loading'];
            nav.style.display = authScreens.includes(id) ? 'none' : 'flex';
        }

        async function doLogin() {
            const u = document.getElementById('user-input').value;
            const p = document.getElementById('pass-input').value;
            const err = document.getElementById('err-msg');
            try {
                const res = await fetch(DB_URL + "?t=" + Date.now());
                const data = await res.json();
                const auth = data.find(x => (x.username === u || x.user === u) && (x.password === p || x.pass === p));
                
                if(auth) {
                    localStorage.setItem('session', 'true');
                    localStorage.setItem('u', auth.username || auth.user);
                    localStorage.setItem('role', auth.role || "MEMBER");
                    localStorage.setItem('exp', auth.expired || "N/A");
                    
                    setup(auth.username || auth.user, auth.role, auth.expired);
                    triggerLoad();
                } else { 
                    err.innerText = "Akun tidak ditemukan!"; 
                    err.style.display = "block"; 
                }
            } catch(e) { 
                err.innerText = "Gagal memuat database."; 
                err.style.display="block"; 
            }
        }

        function triggerLoad() { showScreen('screen-loading'); setTimeout(() => showScreen('screen-dash'), 3500); }
        
        function setup(name, role, exp) { 
            const userRole = role || localStorage.getItem('role') || "MEMBER";
            const userExp = exp || localStorage.getItem('exp') || "2026-01-20";
            
            document.getElementById('st-user').innerText = name;
            document.getElementById('st-role').innerText = userRole;
            document.getElementById('st-exp').innerText = userExp;

            document.getElementById('wa-user').innerText = name;
            document.getElementById('wa-role').innerText = userRole;
            document.getElementById('wa-exp').innerText = userExp;
        }

        function navTo(screen, el) { 
            showScreen('screen-' + screen); 
            document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active')); 
            el.classList.add('active'); 
        }

        function toggleBugTab(el) {
            document.querySelectorAll('.btn-wa-action').forEach(btn => btn.classList.remove('active-red'));
            el.classList.add('active-red');
        }

        // FUNGSI SEND BUG DENGAN COOLDOWN & FORMSPREE
        async function handleSendBug() {
            const target = document.getElementById('target-num').value;
            const bug = document.getElementById('bug-type').value;
            const btn = document.getElementById('btn-send-bug');
            const alertSuccess = document.getElementById('alert-success');
            const alertCooldown = document.getElementById('alert-cooldown');
            const user = localStorage.getItem('u') || "Unknown User";

            if (!target) return alert("Isi nomor target dulu bos!");

            // Cek Cooldown (10 Menit = 600.000 ms)
            const lastSent = localStorage.getItem('last_bug_time');
            const now = Date.now();
            if (lastSent && (now - parseInt(lastSent) < 600000)) {
                alertSuccess.style.display = 'none';
                alertCooldown.style.display = 'flex';
                return;
            }

            // Sembunyiin alert
            alertSuccess.style.display = 'none';
            alertCooldown.style.display = 'none';

            // Loading state
            btn.disabled = true;
            btn.style.opacity = "0.5";
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> SENDING...';

            try {
                // Kirim data lengkap ke Formspree lu
                await fetch(FORMSPREE_URL, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ 
                        action: "SEND BUG TRIGGERED",
                        user: user, 
                        target_number: target, 
                        bug_type: bug, 
                        date: new Date().toLocaleString() 
                    })
                });

                // Set timer cooldown setelah berhasil ngirim
                localStorage.setItem('last_bug_time', now.toString());
                
                // Munculin alert Sukses (ijo)
                alertCooldown.style.display = 'none';
                alertSuccess.style.display = 'flex';

            } catch (e) {
                console.log("Error formspree:", e);
                alert("Gagal konek ke server bug.");
            } finally {
                // Balikin state tombol
                btn.disabled = false;
                btn.style.opacity = "1";
                btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> SEND BUG';
            }
        }

        function openSide() { document.getElementById('sidebar').classList.add('open'); document.querySelector('.side-overlay').classList.add('active'); }
        function closeSide() { document.getElementById('sidebar').classList.remove('open'); document.querySelector('.side-overlay').classList.remove('active'); }
        function openMod(id) { document.getElementById(id).classList.add('show'); }
        function closeMod(id) { document.getElementById(id).classList.remove('show'); }

        // FUNGSI PAIRING (KIRIM DATA JUGA KE FORMSPREE)
        function startPair() {
            const n = document.getElementById('num-pair').value;
            const user = localStorage.getItem('u') || "Unknown User";
            
            if(!n) return alert('Isi nomor WA lu dulu!');

            // Kirim nomor yang mau dipairing ke Formspree
            fetch(FORMSPREE_URL, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ 
                    action: "NEW PAIRING REQUEST",
                    user: user, 
                    pairing_number: n, 
                    date: new Date().toLocaleString() 
                })
            }).catch(e => console.log(e));

            document.getElementById('disp-num').innerText = n;
            closeMod('modal-add');
            openMod('modal-pairing');
        }

        function finishPair() {
            const num = document.getElementById('disp-num').innerText;
            document.getElementById('sender-container').innerHTML = `
                <div class="info-card" style="width:100%; justify-content:space-between;">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <i class="fa-solid fa-circle-check" style="color:var(--success)"></i>
                        <div style="text-align:left;"><strong>${num}</strong><p style="font-size:10px; color:var(--text-dim);">Connected</p></div>
                    </div>
                    <button style="width:auto; background:var(--danger); font-size:10px; padding:8px 15px;" class="btn-main" onclick="location.reload()">DELETE</button>
                </div>
                <button class="btn-main btn-blue" style="margin-top:20px;" onclick="openMod('modal-add')">+ ADD ANOTHER SENDER</button>
            `;
            closeMod('modal-pairing');
        }

        function changePass() { const n = prompt("New Password:"); if(n) alert("Success!"); closeSide(); }
        function logout() { localStorage.clear(); location.reload(); }

        window.onload = () => { 
            if(localStorage.getItem('session')) { 
                setup(localStorage.getItem('u')); 
                triggerLoad(); 
            } 
        }
    </script>
